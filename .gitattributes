# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files (never convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tar.gz binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Text files requiring LF
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.svg text eol=lf
